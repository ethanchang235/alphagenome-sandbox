# SECURITY WARNING: This file contains sensitive API credentials.
# DO NOT commit the actual .env file to version control.
# DO NOT share these credentials in chat or with AI assistants.
# Only edit the actual .env file manually in a secure text editor.

# AlphaGenome API Configuration
ALPHAGENOME_API_KEY=your_api_key_here

# Optional: Cache settings
CACHE_TTL_HOURS=24
CACHE_PATH=predictions_cache.db

# Optional: Rate limiting
MAX_REQUESTS_PER_SECOND=2
DAILY_REQUEST_LIMIT=1000
